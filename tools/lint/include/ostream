#pragma once

/* The recovered SurRender ABI mentions std::ostream only by reference.  VC6's
   pre-standard iostream implementation does not parse as C++14, so the modern
   compile-only lane needs only the incomplete type that these declarations
   actually consume.  The matching compiler continues to use the real VC6
   header. */
namespace std {
template <typename E> struct char_traits {};

/* srDummyStreamBuf derives from streambuf and the recovered constructors
   initialize the spelled-out basic_* bases, so the recovered surface needs
   the complete template forms. */
template <typename E, typename T> class basic_streambuf {
public:
    /* The deleting destructor slot is real in VC6: srWindowOut deletes its
       buffer through this base. */
    virtual ~basic_streambuf();
    virtual int overflow(int ch);
    virtual int underflow();
    virtual int sync();
};
typedef basic_streambuf<char, char_traits<char> > streambuf;

/* The recovered dump methods spell the ios formatting surface: flags()/setf()
   plus width(). */
class ios {
public:
    typedef int fmtflags;
    enum { left = 0x40, adjustfield = 0x1c0 };
    fmtflags flags() const;
    fmtflags flags(fmtflags value);
    fmtflags setf(fmtflags mask, fmtflags field);
    int width() const;
    int width(int value);
    /* srWindowOut's destructor releases its window stream buffer through
       rdbuf(). */
    streambuf* rdbuf() const;
};

template <typename E, typename T> class basic_ostream : public ios {
public:
    basic_ostream(basic_streambuf<E, T>* buffer);
    /* The RichEdit stream-out callback writes the window text through the
       VC6 unformatted-output member. */
    basic_ostream& write(const E* data, long count);
    basic_ostream& operator<<(int value);
    basic_ostream& operator<<(long value);
    basic_ostream& operator<<(unsigned long value);
    basic_ostream& operator<<(double value);
    /* Stream manipulators (std::endl) are spelled by srGERD::dump. */
    basic_ostream& operator<<(basic_ostream& (*manipulator)(basic_ostream&));
};
typedef basic_ostream<char, char_traits<char> > ostream;

ostream& operator<<(ostream& stream, const char* value);
ostream& operator<<(ostream& stream, const void* value);
ostream& operator<<(ostream& stream, char value);

/* srGERD::dump spells std::endl; VC6 defines it in <ostream>. */
template <typename E, typename T>
basic_ostream<E, T>& endl(basic_ostream<E, T>& stream);
} // namespace std
