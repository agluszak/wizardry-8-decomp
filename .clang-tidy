# The gating clang-tidy profile: only checks that find reconstruction/type
# errors. Style, naming and modernize checks do not apply to recovered source.
#
# Stock checks are gated only when a whole-tree trial found no false positives.
# Notable exclusions: narrowing conversions (VC6 source narrows implicitly
# everywhere), sizeof-pointer heuristics (allocators size pointer arrays),
# copy-constructor-init (recovered copies deliberately reset bases) and
# suspicious-memory-comparison (memcmp over padded W8CombatSlot is the retail
# idiom). A hit on a gated check means compare with retail; established retail
# behavior, including UB, is not "repaired" for lint.
#
# The wiz8-* checks come from docker/msvc600/clang-tidy-plugin. `wiz8 lint`
# gates them on changed lines only (WIZ8_REDUNDANT_CAST_LINES; `*` audits the
# whole corpus). Cross-record project reinterpret casts have no waiver:
# reconcile the type/prototype.
Checks: >
  -*,
  wiz8-redundant-scalar-cast,
  wiz8-project-record-reinterpret-cast,
  bugprone-misplaced-widening-cast,
  readability-redundant-casting,
  bugprone-sizeof-expression,
  bugprone-swapped-arguments,
  bugprone-suspicious-enum-usage,
  bugprone-pointer-arithmetic-on-polymorphic-object,
  readability-redundant-declaration,
  bugprone-chained-comparison,
  bugprone-infinite-loop,
  bugprone-misleading-setter-of-reference,
  bugprone-misplaced-operator-in-strlen-in-alloc,
  bugprone-misplaced-pointer-arithmetic-in-alloc,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare
CheckOptions:
  bugprone-sizeof-expression.WarnOnSizeOfPointerToAggregate: 'false'
  bugprone-sizeof-expression.WarnOnSizeOfPointer: 'false'
  bugprone-suspicious-enum-usage.StrictMode: 'false'
  bugprone-pointer-arithmetic-on-polymorphic-object.IgnoreInheritedVirtualFunctions: 'true'
  bugprone-suspicious-string-compare.WarnOnImplicitComparison: 'false'
  bugprone-suspicious-string-compare.WarnOnLogicalNotComparison: 'false'
WarningsAsErrors: '*'
# Match first-party trees by repository-relative path so the same filter
# works under Docker's /repo mount, a local checkout, and relative
# compile-database entries. Do not hard-code /repo here.
HeaderFilterRegex: '(^|/)(include/wiz8|include/surrender|src/wiz8|src/surrender|src/srext_jpegimporter|src/srext_unzip)/'
FormatStyle: none
