# The gating clang-tidy profile. It deliberately stays much narrower than the
# compiler lane and contains only checks that find reconstruction/type errors;
# style, naming and modernize checks are not applicable to decompiled source.
#
# Exclusions, with the binary/source evidence:
# - bugprone-narrowing-conversions / cppcoreguidelines-narrowing-conversions,
#   -Wconversion, -Wsign-conversion: VC6 source and the recovered corpus narrow
#   implicitly everywhere (GUI code int -> INT16), so as errors they demand
#   hundreds of suppressions without finding reconstruction errors.
# - bugprone-sizeof-expression pointer heuristics: recovered allocators
#   deliberately size pointer arrays (`sizeof(T*)`), which Clang reports as
#   "pointer to aggregate". The rest of the check stays on.
# - Imperialism-audit noise that mostly restated faithful compiler/source shape
#   or incomplete naming: bugprone-branch-clone, clang-analyzer-deadcode.DeadStores,
#   misc-redundant-expression, bugprone-assignment-in-if-condition,
#   bugprone-casting-through-void, readability-suspicious-call-argument,
#   bugprone-suspicious-memset-usage. Clang 19 already covers the useful
#   memory diagnostics in the compiler lane.
# - bugprone-virtual-near-miss: a trial only found srBinFStream::pseek/ptell
#   versus seek/tell, which are distinct virtuals. Remaining FunctionXXXXX
#   names would make its similarity heuristic worse, not better.
# - bugprone-multi-level-implicit-pointer-conversion: trial found implicit
#   T** -> void* at growable-vector / PList / FileRead / hash APIs. Those
#   opaque-storage boundaries should become explicit, but gating now would
#   demand a cast sweep rather than a reconstruction fix.
# - bugprone-copy-constructor-init: a hit means compare the constructor with
#   retail, not insert Base(other). Recovered copies such as stTextureAnim
#   and stLightDefinition deliberately reset registry/runtime bases.
# - bugprone-unhandled-self-assignment: hundreds of hits in vector/srArray/
#   srPtr assignment templates; too noisy to gate.
Checks: >
  -*,
  bugprone-misplaced-widening-cast,
  readability-redundant-casting,
  bugprone-sizeof-expression,
  bugprone-swapped-arguments,
  bugprone-suspicious-enum-usage,
  bugprone-pointer-arithmetic-on-polymorphic-object,
  readability-duplicate-include,
  readability-redundant-declaration
CheckOptions:
  bugprone-sizeof-expression.WarnOnSizeOfPointerToAggregate: 'false'
  bugprone-sizeof-expression.WarnOnSizeOfPointer: 'false'
  bugprone-suspicious-enum-usage.StrictMode: 'false'
  bugprone-pointer-arithmetic-on-polymorphic-object.IgnoreInheritedVirtualFunctions: 'true'
WarningsAsErrors: '*'
# Match first-party trees by repository-relative path so the same filter
# works under Docker's /repo mount, a local checkout, and relative
# compile-database entries. Do not hard-code /repo here.
HeaderFilterRegex: '(^|/)(include/wiz8|include/surrender|src/wiz8|src/surrender|src/srext_jpegimporter|src/srext_unzip)/'
FormatStyle: none
