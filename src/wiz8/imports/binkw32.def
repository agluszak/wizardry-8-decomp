LIBRARY BINKW32

; Bink's exported stdcall names, including their leading underscores.
; VC6's directive-based import generation preserves these exact DLL names.

EXPORTS
    _BinkDDSurfaceType@4
    _BinkCopyToBuffer@28
    _BinkGetRects@8
    _BinkPause@8
    _BinkSetVolume@8
    _BinkClose@4
    _BinkSetSoundSystem@8
    _BinkOpenMiles@4
    _BinkOpen@8
    _BinkDoFrame@4
    _BinkWait@4
    _BinkNextFrame@4
