LIBRARY BINKW32

; Closed Bink middleware import surface used by Engine Code\Bink.cpp. Every
; decorated export is taken from the canonical Wiz8.exe import table. As with
; mss32.def, entries omit the leading underscore because LIB supplies the
; public __stdcall decoration.

EXPORTS
    BinkDDSurfaceType@4
    BinkCopyToBuffer@28
    BinkGetRects@8
    BinkPause@8
    BinkSetVolume@8
    BinkClose@4
    BinkSetSoundSystem@8
    BinkOpenMiles@4
    BinkOpen@8
    BinkDoFrame@4
    BinkWait@4
    BinkNextFrame@4
