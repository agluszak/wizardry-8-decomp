LIBRARY MSS32

; Miles' exported stdcall names, including their leading underscores.
; The retail EXE observation spells _AIL_init_sample@ without its byte count.
; The owning Mss.h declaration, one-argument caller, and provider export agree
; on _AIL_init_sample@4; use that callable identity.

EXPORTS
    _AIL_3D_provider_attribute@12
    _AIL_3D_sample_playback_rate@4
    _AIL_3D_sample_status@4
    _AIL_3D_sample_volume@4
