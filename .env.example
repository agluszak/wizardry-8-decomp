GHIDRA_INSTALL_DIR=/absolute/path/to/ghidra_12.1.2_PUBLIC
WIZ8_INPUT_DIR=/absolute/path/to/local/wizardry8-inputs

# Generated and proprietary working data: extracted installers, materialized
# variants, pinned source oracles, Wine prefixes, and the live Ghidra project.
# Keep it outside the checkout so game data cannot be committed accidentally.
#
# Each concurrently active checkout should use its own WIZ8_WORK_DIR. Immutable
# subtrees may be copied with `cp -al`, but never hardlink `ghidra/`: it is the
# checkout's single live Ghidra project and Ghidra writes it in place.
WIZ8_WORK_DIR=/absolute/path/to/generated/wizardry8-work

# Optional explicit location for the one live Ghidra project. By default it is
# WIZ8_WORK_DIR/ghidra.
#WIZ8_GHIDRA_PROJECT_DIR=/absolute/path/to/generated/wizardry8-work/ghidra
