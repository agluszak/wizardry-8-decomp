GHIDRA_INSTALL_DIR=/absolute/path/to/ghidra_12.1.2_PUBLIC
WIZ8_INPUT_DIR=/absolute/path/to/local/wizardry8-inputs

# Generated proprietary data and source oracles. Keep this outside the
# checkout. Give concurrent checkouts separate work directories.
WIZ8_WORK_DIR=/absolute/path/to/generated/wizardry8-work

# The live Ghidra project defaults to <checkout>/ghidra-project so every
# workspace owns its project by construction. Set this only to relocate one
# checkout's project; never point two checkouts at the same directory, and
# never hardlink a live project, because Ghidra writes it in place.
#WIZ8_GHIDRA_PROJECT_DIR=/absolute/path/to/ghidra-project
