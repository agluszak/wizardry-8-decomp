GHIDRA_INSTALL_DIR=/absolute/path/to/ghidra_12.1.2_PUBLIC
WIZ8_INPUT_DIR=/absolute/path/to/local/wizardry8-inputs

# WIZ8_WORK_DIR must be UNIQUE PER CHECKOUT. Every jj workspace or git worktree
# needs its own, because this directory holds mutable build state: the CMake
# cache (which records the host source path reccmp maps addresses through), the
# linked Wiz8.exe/Wiz8.pdb, live Ghidra projects and the query daemon.
#
# Two checkouts sharing one WIZ8_WORK_DIR silently overwrite each other's build.
# The failure is quiet and misleading: `just compare` will happily read a
# Wiz8.pdb linked from the *other* checkout's sources and report your functions
# as 30-40% similar when they are actually correct.
#
# The large read-only trees - extracted, variants, fid, oracles - can be shared
# between checkouts with `cp -al` hardlink copies, which costs almost no disk.
# Plain symlinks do NOT work: the tooling requires generated targets to resolve
# to real paths under WIZ8_WORK_DIR.
WIZ8_WORK_DIR=/absolute/path/to/generated/wizardry8-work-<checkout-name>
