GHIDRA_INSTALL_DIR=/absolute/path/to/ghidra_12.1.2_PUBLIC
WIZ8_INPUT_DIR=/absolute/path/to/local/wizardry8-inputs

# Large generated data that is expensive to rebuild: extracted installers,
# materialized variants, pinned FID sources, source oracles, and live Ghidra
# projects. It stays outside the checkout so proprietary game data can never be
# committed to a public repository.
#
# Several checkouts MAY share one of these. The CMake build directory - the
# state two checkouts used to fight over - now lives at build/decomp inside each
# checkout, so builds and reccmp comparisons are isolated by construction.
# Live Ghidra projects under this directory are still stateful, so avoid running
# mutating Ghidra commands from two checkouts against a shared one at once.
WIZ8_WORK_DIR=/absolute/path/to/generated/wizardry8-work
