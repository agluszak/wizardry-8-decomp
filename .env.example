GHIDRA_INSTALL_DIR=/absolute/path/to/ghidra_12.1.2_PUBLIC
WIZ8_INPUT_DIR=/absolute/path/to/local/wizardry8-inputs

# Large generated data that is expensive to rebuild: extracted installers,
# materialized variants, pinned FID sources, source oracles, and live Ghidra
# projects. It stays outside the checkout so proprietary game data can never be
# committed to a public repository.
#
# Give every concurrently active checkout its own. Builds and reccmp comparisons
# are isolated by construction - the CMake build directory now lives at
# build/decomp inside each checkout - but Ghidra is not: agents materializing at
# once serialize on this directory's materialize.lock, and because the project is
# content-addressed over the reviewed evidence, every evidence commit another
# agent lands invalidates the cache and forces a fresh GZF restore.
#
# Building one costs no disk. Hardlink the immutable input trees and let the rest
# be rebuilt:
#
#   mkdir -p /path/to/wizardry8-work-mine
#   for d in extracted fid variants oracles sgp; do
#       cp -al /path/to/wizardry8-work/$d /path/to/wizardry8-work-mine/$d
#   done
#
# Do NOT hardlink ghidra/: it is a live Ghidra project written in place, and
# sharing its inodes corrupts the original. It, ghidra-agents/ and daemon/ are
# rebuilt on first use, which is what restoring the canonical GZF already does.
WIZ8_WORK_DIR=/absolute/path/to/generated/wizardry8-work

# Required. Separates this checkout's Ghidra project from every other agent's.
# There is no default on purpose: two checkouts sharing one identity share one
# per-agent project root and collide on its lock. Anything unique will do; the
# checkout's directory name is the obvious choice.
WIZ8_GHIDRA_AGENT_ID=my-checkout-name

# Optional. How many materialized Ghidra projects to keep per agent; default 3.
# Each is about 51MB and a new one is built whenever reviewed evidence changes.
#WIZ8_GHIDRA_KEEP_MATERIALIZATIONS=3
